# EduTrace frontend configuration
# Copy to `.env` for local use. Never commit `.env` or put secrets in VITE_* variables:
# Vite inlines every VITE_* value into the browser bundle.

# Data source for the UI: "mock" uses the deterministic demonstration dataset
# persisted in the browser. "http" calls the Django REST Framework backend.
VITE_API_MODE=mock

# Base URL of the Django REST Framework API. Required when VITE_API_MODE=http.
# Example: https://api.edutrace.example.gov.in/api/v1
VITE_API_BASE_URL=

# Request timeout in milliseconds for the HTTP client.
VITE_API_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# Keycloak / OpenID Connect (integration phase only; unused by the mock build)
# These are public client identifiers, not secrets. The production flow must be
# Authorization Code + PKCE handled by a Keycloak adapter, and tokens must not
# be written to localStorage or sessionStorage.
# ---------------------------------------------------------------------------
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=
